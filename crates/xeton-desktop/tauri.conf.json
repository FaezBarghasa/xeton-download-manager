{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xeton Download Manager",
  "version": "0.9.0",
  "identifier": "com.xeton.downloadmanager",
  "build": {
    "frontendDist": "../xeton-ui/dist",
    "devUrl": "http://localhost:8080"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Xeton Download Manager",
        "width": 1050,
        "height": 680,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../assets/logo/app_logo_with_background.svg"
    ]
  }
}
