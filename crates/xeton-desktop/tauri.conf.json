{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xeton Download Manager",
  "version": "0.9.0",
  "identifier": "com.xeton.downloadmanager",
  "build": {
    "frontendDist": "../xeton-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Xeton Download Manager",
        "width": 1050,
        "height": 680,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "devtools": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../assets/logo/app_logo_with_background.svg"
    ]
  }
}
